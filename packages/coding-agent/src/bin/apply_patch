#!/usr/bin/env bash
# Apply GPT-style patches using the Python script

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="${SCRIPT_DIR}/apply_patch.py"

if [ ! -f "$PYTHON_SCRIPT" ]; then
    echo "Error: apply_patch.py not found at $PYTHON_SCRIPT" >&2
    exit 1
fi

exec python3 "$PYTHON_SCRIPT" "$@"
